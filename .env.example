# Frontend Mode
VITE_USE_MOCK_DATA=false
VITE_API_BASE_URL=/api

# Supabase Credentials (Required for cloud report & entity persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key

# Station login aliases. Create both users in Supabase Auth first, then map
# their Auth user UUIDs in supabase/migrations/001_multi_station_sharing.sql.
VITE_STATION_A_ID=station-a
VITE_STATION_A_EMAIL=station-a@example.invalid
VITE_STATION_B_ID=station-b
VITE_STATION_B_EMAIL=station-b@example.invalid

# Neo4j Graph DB (Optional)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# Grounded Investigation AI (Gemini key stays server-side and must never be committed)
LLM_ENABLED=true
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.7-flash
LLM_TIMEOUT_SECONDS=90
GEMINI_API_KEY=
# Free-tier prompts may be used to improve Google products. Keep false for real FIR data.
ALLOW_CLOUD_FIR_PROCESSING=false
ENABLE_LOCAL_TRANSFORMERS=false
ENABLE_AI_INVESTIGATOR=true
ENABLE_INVESTIGATION_SANDBOX=true
AUTH_MODE=demo
# Production: set AUTH_MODE=required. The backend validates the existing
# Supabase access token and station_members row; it does not issue sessions.
SUPABASE_AUTH_TIMEOUT_SECONDS=5
# Optional comma-separated Supabase Auth UUIDs for privileged backend actions.
SUPERVISOR_USER_IDS=
ADMIN_USER_IDS=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.vercel.app
EXPOSE_API_DOCS=false
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_FILES=5
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
SENSITIVE_RATE_LIMIT_REQUESTS=10
